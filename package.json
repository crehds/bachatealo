{
  "homepage": "https://crehds.github.io/bachatealo",
  "name": "bachatealo",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "postcss": "^8.2.8",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "build:css": "postcss src/cssDev/App.css -o src/cssProd/index.css",
    "watch:css": "postcss src/cssDev/App.css -o src/cssProd/index.css -w",
    "dev-js": "vite",
    "dev": "npm-run-all -p watch:css dev-js",
    "build-js": "vite build",
    "build": "npm-run-all build:css build-js",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "css-mqpacker": "^7.0.0",
    "gh-pages": "^3.1.0",
    "jsdom": "^30.1.0",
    "npm-run-all": "^4.1.5",
    "postcss-apply": "^0.12.0",
    "postcss-cli": "^8.3.1",
    "postcss-import": "^12.0.1",
    "postcss-preset-env": "^6.7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
